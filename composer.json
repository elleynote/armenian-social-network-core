{
  "name": "elleynote/armenian-social-network-core",
  "description": "Core social-network plugin for Armenian Social Network.",
  "type": "wordpress-plugin",
  "license": "proprietary",
  "require": {
    "php": ">=7.4"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6",
    "squizlabs/php_codesniffer": "^3.10",
    "wp-coding-standards/wpcs": "^3.1"
  },
  "scripts": {
    "test": "phpunit -c phpunit.xml.dist",
    "lint": "phpcs --standard=phpcs.xml.dist --warning-severity=0"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "sort-packages": true
  }
}
